MONGO_URI=mongodb://127.0.0.1:27017/codefolio
JWT_SECRET=change-me-to-a-long-random-string
PORT=5000
# Hostname of the main app (e.g. codefolio.com). Any other Host is checked against Pro custom domains.
APP_HOST=localhost
# Leave SMTP_HOST empty in development: contact messages are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CodeFolio <no-reply@codefolio.com>
